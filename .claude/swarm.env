# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=tilelink-to-axi4-bridge
GH_REPO=markrthomas/tilelink-to-axi4-bridge
DUT_TOP=TLUHToAXI4

# The design is Chisel: edit the Scala, `make elab` regenerates generated/*.sv (git-ignored). Never edit generated SV.
RTL_DIR=src/main/scala
TB_DIR=test

DV_ENVS="sim cocotb sim-chi cocotb-chi"
GATE_TARGET=check
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal elab-widths coverage"
HEAVY_TARGETS="regress coverage coverage-chi formal ci"

MUTATION_FILE=src/main/scala/tlbridge/TLUHToAXI4.scala
MUTATION_HINT="flip one condition on the D-channel response path (make elab regenerates the SV)"

RR_DIR=test/random
RR_STATUS=bootstrap

METRICS=no
