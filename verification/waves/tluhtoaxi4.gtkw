[*]
[*] TLUHToAXI4 — curated GTKWave layout
[*] Groups signals by function (clock/reset, FSM, TL-A, TL-D, AXI AW/W/B, AXI AR/R)
[*] so a fresh `make wave` run is readable without manually dragging signals in.
[*]
[dumpfile] "sim.vcd"
[dumpfile_mtime] "0"
[dumpfile_size] 0
[savefile] "verification/waves/tluhtoaxi4.gtkw"
[timestart] 0
[size] 1600 900
[pos] -1 -1
[sst_width] 300
[signals_width] 300
[sst_expanded] 1
[sst_vpaned_height] 350
