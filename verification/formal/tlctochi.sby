# tlctochi.sby — SymbiYosys proof script for TLCToCHI
#
# Covers Stages 2–6 (read / release / snoop / uncached + atomic).
#
# Tasks:
#   bmc   — safety: F-CHI-1..11
#   cover — reachability: 19 cover goals across all four engines

[tasks]
bmc
cover

[options]
bmc:   mode bmc
cover: mode cover
depth 30

[engines]
smtbmc yices

[script]
read -sv tlctochi_props.sv TLCToCHI.sv
hierarchy -top tlctochi_props
proc
opt
memory_map
flatten
opt

[files]
tlctochi_props.sv
../../generated/chi/TLCToCHI.sv
